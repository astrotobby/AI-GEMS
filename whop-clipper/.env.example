# Whop *user* token (OAuth access token). Account/company API keys can read bounties but
# cannot create submissions. See README "Getting a Whop user token".
WHOP_TOKEN=

# Composio: Settings -> API keys. COMPOSIO_USER_ID is the user id your accounts are connected under.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# YouTube: your own Google OAuth client (Desktop app) and one refresh token per channel
# (python get_youtube_token.py). Never commit real values.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_ASTRO_TOBBY=
YOUTUBE_REFRESH_TOKEN_DIJITOL_NOMAD=

# Optional: better moment picking + copy. Without it a free transcript heuristic is used.
ANTHROPIC_API_KEY=

# Your existing Telegram bot + the chat it should report to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional override of config.toml mode: review | auto
CLIPPER_MODE=
